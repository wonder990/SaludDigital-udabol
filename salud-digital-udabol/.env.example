# URL del proyecto de Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (publishable / anon). NO uses la clave secreta ni service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publica

# Nombres alternativos aceptados (opcional, usa solo uno):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica
# NEXT_PUBLIC_SUPABASE_KEY=tu-clave-publica

# Código para registrar administradores. Cámbialo antes de publicar.
NEXT_PUBLIC_ADMIN_CODE=CAMBIA_ESTE_CODIGO
